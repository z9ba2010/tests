# Environment (staging | production)
TEST_ENV=staging

# Backend Services
PARSER_API_BASE_URL=https://api.staging.internal/parser
API_AUTH_TOKEN=your_test_bearer_token_here
REQUEST_TIMEOUT=15

# Appium Mobile Testing
APPIUM_SERVER_URL=http://127.0.0.1:4723
DEVICE_NAME="Android Emulator"
PLATFORM_VERSION="13.0"
IMPLICIT_WAIT=10
EXPLICIT_WAIT=15

# Package identifiers (Android)
WARDROBE_PACKAGE=com.sportwardrobe.app
WARDROBE_ACTIVITY=com.sportwardrobe.app.MainActivity
WARDROBE_APK=./apps/wardrobe.apk

MAXFUNFIT_PACKAGE=com.maxfunfit.app
MAXFUNFIT_ACTIVITY=com.maxfunfit.app.MainActivity
MAXFUNFIT_APK=./apps/maxfunfit.apk

MATRESHKA_PACKAGE=com.matreshka.app
MATRESHKA_ACTIVITY=com.matreshka.app.MainActivity
MATRESHKA_APK=./apps/matreshka.apk
